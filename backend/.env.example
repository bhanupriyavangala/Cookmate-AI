# ClientPulse AI - Backend Environment Configuration

PROJECT_NAME="ClientPulse AI"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientpulse_db

# Gemini AI Configuration (Backend Only - Never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Employee Authentication (Secures employee API endpoints)
EMPLOYEE_API_KEY=cp_employee_secret_key_2026

# Portal Base URL (for generating client communication links)
PORTAL_BASE_URL=http://localhost:5173

# Email Provider Configuration (Phase 7 Email Integration)
# Supported options: mock (default for testing/dev), smtp, resend, sendgrid
EMAIL_PROVIDER=mock
EMAIL_FROM="ClientPulse AI <notifications@clientpulse.ai>"
EMAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=cp_webhook_secret_key_2026

# SMTP Configuration (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# Resend API Key (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_resend_api_key_here

# SendGrid API Key (required when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

