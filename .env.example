# ============================================
# ClientPulse AI - Master Environment Variables
# ============================================

# --- Backend Configuration ---
PROJECT_NAME="ClientPulse AI"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientpulse_db

# Gemini AI API Key (Backend Only - Never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Employee Authentication (Secures internal employee endpoints)
EMPLOYEE_API_KEY=cp_employee_secret_key_2026

# Portal Base URL for generating unique client links
PORTAL_BASE_URL=http://localhost:5173

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="ClientPulse AI"
VITE_EMPLOYEE_KEY=cp_employee_secret_key_2026

